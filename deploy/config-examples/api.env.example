# CONFIG_DIR/api.env (root, mode 600). The API's settings; never commit the filled-in file.
ConnectionStrings__Main=Host=postgres;Database=basachai;Username=basachai_api;Password=<API_DB_PASSWORD>
# 16+ random characters; salts the hashed IPs and device ids.
Hashing__Salt=
Auth__CookieDomain=.example.com
Web__Origin=https://www.example.com
# Page purges after changes (the web app's /api/revalidate); the same secret is REVALIDATE_SECRET on Netlify.
Web__RevalidateUrl=https://www.example.com/api/revalidate
Web__RevalidateSecret=
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__UploadPreset=
# Staging only: the test hooks need this header value (X-Test-Key).
# Test__HookKey=

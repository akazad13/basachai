# CONFIG_DIR/backup.env. The private key that matches BACKUP_RECIPIENT_FILE is kept off this server
# (import it only when restoring).
BACKUP_DIR=/var/backups/basachai
BACKUP_RECIPIENT_FILE=/etc/basachai/backup-public.asc
# An rclone remote for the off-site copy, set up with `rclone config` (empty: local copies only).
BACKUP_REMOTE=offsite:basachai-backups

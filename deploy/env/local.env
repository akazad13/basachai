# The production setup on a developer machine: Caddy's local CA instead of the Cloudflare certificate, on port 8443.
COMPOSE_PROJECT_NAME=basachai-local
COMPOSE_PROFILES=edge
CONFIG_DIR=./local-config
APP_ENV=Production
DB_NAME=basachai
API_ALIAS=api-production
TLS_MODE=internal
ORIGIN_CHECK=off
HTTPS_PORT=8443
PG_MEM=512m
PG_SHARED_BUFFERS=128MB
PG_CACHE_SIZE=256MB
API_MEM=512m

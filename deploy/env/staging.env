# Staging: its own Compose project, database and key ring; served by production's Caddy. Stop it between releases.
COMPOSE_PROJECT_NAME=basachai-staging
COMPOSE_PROFILES=
CONFIG_DIR=/etc/basachai-staging
APP_ENV=Staging
# The test hooks reseed only a database whose name contains "staging".
DB_NAME=basachai_staging
API_ALIAS=api-staging
PG_MEM=512m
PG_SHARED_BUFFERS=128MB
PG_CACHE_SIZE=256MB
API_MEM=512m
